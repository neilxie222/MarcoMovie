[Unit]
Description=Gomovie Sync (WebDAV sync backend + admin panel)
Documentation=https://github.com/neilxie222/MarcoMovie/tree/main/server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gomovie
Group=gomovie
WorkingDirectory=/opt/gomovie-sync
Environment=GOMOVIE_SYNC_ROOT=/var/lib/gomovie-sync
Environment=GOMOVIE_SYNC_URL=https://sync.open999000.xyz
Environment=GOMOVIE_SYNC_LISTEN=0.0.0.0
Environment=GOMOVIE_SYNC_PORT=80
ExecStart=/usr/bin/python3 /opt/gomovie-sync/gomovie_sync.py
# Port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/gomovie-sync
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
